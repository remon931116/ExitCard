{
  "manifest_version": 3,
  "name": "ExitCard TKU Connector",
  "version": "1.1",
  "description": "將淡江個人課表同步到 ExitCard",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sso.tku.edu.tw/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}